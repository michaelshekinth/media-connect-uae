{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build --config advertisers/vite.config.ts",
  "outputDirectory": "dist/advertisers",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
