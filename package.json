{
  "name": "media-connect-uae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config advertisers/vite.config.ts",
    "dev:owner": "vite --config media-owner/vite.config.ts",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:admin": "vite --config super-admin/vite.config.ts",
    "dev:all": "concurrently -n api,adv,owner,admin -c blue,green,yellow,magenta \"npm run dev:api\" \"npm run dev\" \"npm run dev:owner\" \"npm run dev:admin\"",
    "seed": "tsx server/src/seed/seed.ts",
    "build": "tsc -b && vite build --config advertisers/vite.config.ts && vite build --config media-owner/vite.config.ts && vite build --config super-admin/vite.config.ts",
    "build:api": "tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview --config advertisers/vite.config.ts",
    "preview:owner": "vite preview --config media-owner/vite.config.ts",
    "preview:admin": "vite preview --config super-admin/vite.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.20.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
