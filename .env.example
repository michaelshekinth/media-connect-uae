# API
API_PORT=4000
JWT_SECRET=change-me-in-production

# MongoDB — required on Vercel (Atlas). Local: docker compose up -d
MONGODB_URI=mongodb://localhost:27017/mediaconnect

# Vercel — set on media-owner & super-admin projects (main app URL, no trailing slash)
# VITE_API_URL=https://your-advertisers-project.vercel.app
# VITE_ADVERTISER_URL=https://your-advertisers-project.vercel.app
# VITE_MEDIA_OWNER_URL=https://your-media-owner-project.vercel.app
# VITE_ADMIN_URL=https://your-super-admin-project.vercel.app
